---
/**
 * 全站共用版面：輸出語系、標題、描述、canonical 與 Open Graph，並把內容包在 <main>。
 *
 * 為了讓回應標頭的 CSP 維持只允許同源：
 * - 這裡與所有元件都不寫 <script>、不用 style 屬性。
 * - 樣式只從外部樣式檔載入。
 */
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  /** 頁面標題，全站每頁不可重複。 */
  title: string;
  /** 頁面描述。 */
  description: string;
  /** 頁面語系，預設中文。 */
  lang?: 'zh-Hant-TW' | 'en';
  /** 設為 true 時不讓搜尋引擎收錄，也不輸出 canonical（例如 404 頁）。 */
  noindex?: boolean;
}

const { title, description, lang = 'zh-Hant-TW', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogLocale = lang === 'en' ? 'en_US' : 'zh_TW';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} ${site.alternateName}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

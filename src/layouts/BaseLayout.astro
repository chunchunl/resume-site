---
/**
 * 全站共用版面：輸出語系、標題、描述、canonical、Open Graph 與 JSON-LD，
 * 並放上導覽、頁尾與包住主要內容的 <main>。
 *
 * 為了讓回應標頭的 CSP 維持只允許同源：
 * - 這裡與所有元件都不寫行內 <script>（JSON-LD 除外）、不用 style 屬性。
 * - 樣式只從外部樣式檔載入。
 * - 唯一的外部腳本是 Cloudflare Web Analytics，在 </body> 前輸出；token 未填時不輸出。
 */
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';
import { buildAnalyticsBeacon } from '../lib/analytics';
import { buildPageMeta, serializeJsonLd, type HtmlLang, type JsonLd } from '../lib/seo';

interface Props {
  /** 頁面標題，全站每頁不可重複。 */
  title: string;
  /** 頁面描述。 */
  description: string;
  /** 頁面語系，預設中文。 */
  lang?: HtmlLang;
  /** 設為 true 時不讓搜尋引擎收錄，也不輸出 canonical（例如 404 頁）。 */
  noindex?: boolean;
  /** 這頁要輸出的 JSON-LD。 */
  jsonLd?: JsonLd[];
}

const { title, description, lang = 'zh-Hant-TW', noindex = false, jsonLd = [] } = Astro.props;
const meta = buildPageMeta(site, { title, description, path: Astro.url.pathname, lang, noindex });
const beacon = buildAnalyticsBeacon(site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 網站圖示：SVG 給新瀏覽器，ICO 給只認 ICO 的環境；兩個檔都在 public/。ICO 只標 32x32，瀏覽器才會優先選 SVG。 */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {meta.robots && <meta name="robots" content={meta.robots} />}
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.ogSiteName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {meta.canonical && <meta property="og:url" content={meta.canonical} />}
    <meta property="og:locale" content={meta.ogLocale} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/* is:inline 讓 Astro 照原樣輸出這個外部腳本，不打包、不改寫成行內程式碼。 */}
    {beacon && <script is:inline defer src={beacon.src} data-cf-beacon={beacon.dataCfBeacon}></script>}
  </body>
</html>
